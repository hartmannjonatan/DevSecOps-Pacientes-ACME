{
  "openapi": "3.0.3",
  "info": {
    "title": "Pacientes ACME — demonstração local",
    "version": "1.0.0",
    "description": "Sem autenticação. Somente dados fictícios. Datas ISO; criação/edição usam formulário. Execute scripts/test-env seed para obter IDs válidos; operações destrutivas exigem fixtures distintas e reposição durante DAST."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8081",
      "description": "Ambiente descartável pelo host"
    },
    {
      "url": "http://app:8080",
      "description": "Scanner conectado à rede acme-test_default"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Banco/esquema indisponível",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "unavailable"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/": {
      "get": {
        "operationId": "listPatients",
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Patient"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/create": {
      "post": {
        "operationId": "createPatient",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/PatientForm"
              }
            },
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/PatientForm"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Patient"
                }
              }
            }
          },
          "409": {
            "description": "Entrada inválida ou registro inexistente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Entrada inválida ou registro inexistente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Entrada inválida ou registro inexistente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/show/{id}": {
      "get": {
        "operationId": "showPatient",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "example": 1,
            "description": "ID retornado por POST /api/create; gere fixtures antes da análise."
          }
        ],
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Patient"
                }
              }
            }
          },
          "404": {
            "description": "Entrada inválida ou registro inexistente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/edit/{id}": {
      "post": {
        "operationId": "editPatient",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "example": 1,
            "description": "ID retornado por POST /api/create; gere fixtures antes da análise."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/PatientForm"
              }
            },
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/PatientForm"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Patient"
                }
              }
            }
          },
          "404": {
            "description": "Entrada inválida ou registro inexistente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Entrada inválida ou registro inexistente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Entrada inválida ou registro inexistente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Entrada inválida ou registro inexistente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/delete/{id}": {
      "delete": {
        "operationId": "deletePatient",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "example": 1,
            "description": "ID retornado por POST /api/create; gere fixtures antes da análise."
          }
        ],
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Entrada inválida ou registro inexistente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/changeStatus/{id}": {
      "post": {
        "operationId": "togglePatient",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "example": 1,
            "description": "ID retornado por POST /api/create; gere fixtures antes da análise."
          }
        ],
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Patient"
                }
              }
            }
          },
          "404": {
            "description": "Entrada inválida ou registro inexistente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/validyCPF/{cpf}": {
      "get": {
        "operationId": "cpfAvailable",
        "description": "Verifica disponibilidade; não valida dígitos verificadores.",
        "parameters": [
          {
            "name": "cpf",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9]{11}$"
            },
            "example": "12345678901"
          }
        ],
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "boolean"
                }
              }
            }
          },
          "422": {
            "description": "Entrada inválida ou registro inexistente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/searchName/": {
      "post": {
        "operationId": "searchPatients",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "input"
                ],
                "properties": {
                  "input": {
                    "type": "string",
                    "maxLength": 100,
                    "example": "DAST"
                  }
                }
              }
            },
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "input"
                ],
                "properties": {
                  "input": {
                    "type": "string",
                    "maxLength": 100,
                    "example": "DAST"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Patient"
                  }
                }
              }
            }
          },
          "422": {
            "description": "Entrada inválida ou registro inexistente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Entrada inválida ou registro inexistente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Patient": {
        "type": "object",
        "required": [
          "id",
          "nome",
          "cpf",
          "sexo",
          "dataNasc",
          "endereco",
          "status"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "nome": {
            "type": "string",
            "maxLength": 100,
            "example": "Paciente Fictício DAST"
          },
          "cpf": {
            "type": "string",
            "pattern": "^[0-9]{11}$",
            "example": "12345678901"
          },
          "sexo": {
            "type": "string",
            "enum": [
              "Masculino",
              "Feminino",
              "Outro"
            ],
            "example": "Outro"
          },
          "dataNasc": {
            "type": "string",
            "format": "date",
            "example": "1995-05-20"
          },
          "endereco": {
            "type": "string",
            "nullable": true,
            "maxLength": 255
          },
          "status": {
            "type": "boolean"
          }
        }
      },
      "PatientForm": {
        "type": "object",
        "required": [
          "nome",
          "cpf",
          "sexo",
          "dataNasc"
        ],
        "properties": {
          "nome": {
            "type": "string",
            "maxLength": 100,
            "example": "Paciente Fictício DAST"
          },
          "cpf": {
            "type": "string",
            "pattern": "^[0-9]{11}$",
            "example": "12345678901"
          },
          "sexo": {
            "type": "string",
            "enum": [
              "Masculino",
              "Feminino",
              "Outro"
            ],
            "example": "Outro"
          },
          "dataNasc": {
            "type": "string",
            "format": "date",
            "example": "1995-05-20"
          },
          "endereco": {
            "type": "string",
            "maxLength": 255,
            "example": "Rua Fictícia, 123"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
