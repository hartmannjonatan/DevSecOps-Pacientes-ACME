#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
action=${1:-install}
[[ "$action" == install || "$action" == update ]] || { echo 'Uso: scripts/dependencies [install|update]' >&2; exit 2; }
docker build --target tooling -t acme-tooling .
docker run --rm --user "$(id -u):$(id -g)" -e COMPOSER_HOME=/tmp/composer -e SYMFONY_DOCKER=0 \
    -v "$PWD:/var/www/html" acme-tooling composer "$action" --prefer-dist --no-interaction --no-progress --no-scripts
# Composer must precede npm: UX React lives inside vendor/.
if [[ "$action" == update ]]; then npm_action=install; else npm_action=ci; fi
docker run --rm --user "$(id -u):$(id -g)" -e npm_config_cache=/tmp/npm \
    -v "$PWD:/app" -w /app node:24-bookworm-slim@sha256:dc26ae92c9fb15cf6b1d63e20f0944b2efe0f115b20e00be48fb23fceb061c54 npm "$npm_action" --include=dev
